{
  "name": "natours",
  "version": "1.0.0",
  "description": "Learning node, express and mongoDB",
  "license": "ISC",
  "author": "Oyewale Ayomide",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:prod": "cross-env NODE_ENV=production nodemon server.js",
    "lint": "eslint .",
    "debug": "ndb server.js",
    "watch:js": "node scripts/watch-js.js",
    "build:js": "node scripts/build-js.js"
  },
  "dependencies": {
    "@babel/polyfill": "^7.12.1",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "html-to-text": "^10.0.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.8.0",
    "morgan": "^1.11.0",
    "multer": "^2.3.0",
    "nodemailer": "^9.0.3",
    "pug": "^3.0.4",
    "sharp": "^0.35.4",
    "slugify": "^1.6.9",
    "stripe": "^22.6.1",
    "validator": "^13.15.35",
    "xss": "^1.0.15",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "connect-livereload": "^0.6.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "glob": "^13.0.6",
    "globals": "^17.8.0",
    "livereload": "^0.10.3",
    "nodemon": "^3.1.14",
    "parcel": "^2.16.4",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3"
  },
  "engines": {
    "node": ">=10.0.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.16.1": true,
    "lmdb@2.8.5": true,
    "msgpackr-extract@3.0.4": true,
    "core-js@2.6.12": true
  },
  "clientBundle": "public/js/dist/entry.js",
  "targets": {
    "clientBundle": {
      "source": "public/js/index.js",
      "context": "browser"
    }
  },
  "nodemonConfig": {
    "ignore": [
      "public/img/users/*",
      "public/img/tours/*",
      "*.log"
    ]
  }
}
